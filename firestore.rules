rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid == 'VZMngh2pukhR8r2RoZpNIopt4R82';
    }
    // Original records are retained intact, but are no longer accessible to visitors.
    match /restaurants/{id} { allow read, write: if admin(); }
    match /publicMenus/{id} {
      allow get: if admin() || resource.data.isActive == true;
      allow list: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly([
        'id','slug','name','nameEn','logo','logoUrl','coverUrl','primaryColor','secondaryColor',
        'currency','statusText','statusTextEn','isActive','type','stitchDesignCode',
        'layoutStyle','fontFamily','borderRadius','updatedAt','categories','products','contact'
      ]);
      allow delete: if admin();
    }
    match /menuDrafts/{id} { allow read, write: if admin(); }
    match /menuVersions/{id}/versions/{versionId} { allow read, write: if admin(); }
    match /settings/{id} { allow read, write: if admin(); }
    match /menuPreviews/{token} {
      allow get: if admin() || (resource.data.status == 'active'
        && resource.data.expiresAt is timestamp && request.time < resource.data.expiresAt);
      allow list: if admin();
      allow create, update, delete: if admin();
    }
    // Reports remain disabled until real analytics and a separate privacy review are ready.
    match /publicReports/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
