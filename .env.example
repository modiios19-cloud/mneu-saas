# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Safe by default. Sandbox uses browser storage with synthetic data, no cloud writes.
VITE_APP_ENV=sandbox
# Separate real staging project (never use the production ID here).
# VITE_APP_ENV=staging
# VITE_FIREBASE_PROJECT_ID=your-separate-staging-project
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_ADMIN_UID=VZMngh2pukhR8r2RoZpNIopt4R82
# Local Firebase integration: VITE_APP_ENV=emulator
# Production is intentionally double-gated; do not enable without owner approval.
# VITE_APP_ENV=production
# VITE_ALLOW_PRODUCTION=true
